services:
  nats:
    image: nats:2.10-alpine
    container_name: AncientReport-nats
    command:
      - "-js"
      - "-sd"
      - "/data"
    ports:
      - "4222:4222" # Expose to host network for agent
      - "8222:8222"
    volumes:
      - nats-data:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - AncientReport
    restart: unless-stopped
    logging:
      driver: syslog
      options:
        syslog-address: "udp://65.109.200.75:5515"
        tag: "{{.Name}}"

  clickhouse:
    image: clickhouse/clickhouse-server:latest
    container_name: AncientReport-clickhouse
    ports:
      - "6123:8123"
      - "6001:9000"
    volumes:
      - clickhouse_data:/var/lib/clickhouse
      - ./clickhouse/init.sql:/docker-entrypoint-initdb.d/init.sql
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    environment:
      TZ: Asia/Tehran
      CLICKHOUSE_DB: AncientReport
      CLICKHOUSE_USER: AncientReport
      CLICKHOUSE_PASSWORD: AncientReport
    networks:
      - AncientReport
    restart: always
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8123/ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    logging:
      driver: syslog
      options:
        syslog-address: "udp://65.109.200.75:5515"
        tag: "{{.Name}}"

  agent:
    build: ./agent
    # image: ghcr.io/itsxcr9/ancientreport/agent:latest  # Commented out to build with prometheus_scraper
    container_name: AncientReport-agent
    network_mode: host
    pid: "host" # Required to see host processes, not container processes
    privileged: true # Required for eBPF
    environment:
      TZ: Asia/Tehran
      # V2 Mode: Enable NATS streaming (comment out to use V1 legacy mode)
      NATS_URL: nats://localhost:4222
      # ClickHouse configuration
      CLICKHOUSE_HOST: localhost
      CLICKHOUSE_PORT: 6123
      CLICKHOUSE_DB: AncientReport
      CLICKHOUSE_USER: AncientReport
      CLICKHOUSE_PASSWORD: AncientReport
      NATS_ENABLED: ${NATS_ENABLED:-true}
      # V4 Prometheus Scraper - Auto-discover and scrape local exporters
      PROMETHEUS_ENABLED: "true"
      PROMETHEUS_AUTO_DISCOVER: "true"
    volumes:
      - /sys/kernel/debug:/sys/kernel/debug:ro
      - /sys/fs/bpf:/sys/fs/bpf:ro
      - /proc:/host/proc:ro
      # Mount config directory instead of file to avoid Docker creating a directory
      - ./agent:/etc/AncientReport/config-source:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      # Mount timezone files to ensure correct time
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    depends_on:
      - clickhouse
      - nats
    restart: unless-stopped
    logging:
      driver: syslog
      options:
        syslog-address: "udp://65.109.200.75:5515"
        tag: "{{.Name}}"

  # Python analysis engine
  analysis:
    build: ./analysis
    container_name: AncientReport-analysis
    ports:
      - "6800:8800"
    environment:
      TZ: Asia/Tehran
      CLICKHOUSE_HOST: clickhouse
      CLICKHOUSE_PORT: 8123
      CLICKHOUSE_DB: AncientReport
      CLICKHOUSE_USER: AncientReport
      CLICKHOUSE_PASSWORD: AncientReport
      GEMINI_API_KEY: AIzaSyBPVfd9gaxGvc0FWZzcruZghvWa7MCTcJQ
      AI_PROVIDER: google
      AI_MODEL: gemini-2.5-flash-lite
      # V2 Mode: Enable NATS ingestion gateway (comment out to use V1 legacy mode)
      NATS_URL: nats://nats:4222
      # Auto-Remediation: Enable real Docker execution (set to false for simulation)
      REMEDIATION_REAL_MODE: "true"
      # Host machine's hostname for multi-server support
      SERVER_HOSTNAME: ${HOSTNAME:-unknown}
      # Worker recycling to prevent memory leaks
      UVICORN_WORKERS: "2"
      UVICORN_LIMIT_MAX_REQUESTS: "1000"
    volumes:
      - ./analysis/src:/app/src
      - /var/run/docker.sock:/var/run/docker.sock
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    depends_on:
      - clickhouse
      - nats
    networks:
      - AncientReport
    # Memory limit to prevent OOM killing other services
    mem_limit: 2g
    memswap_limit: 2g
    # Healthcheck for auto-restart on failure
    healthcheck:
      test: ["CMD", "curl", "-f", "http://65.109.200.75:6800/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    restart: always
    logging:
      driver: syslog
      options:
        syslog-address: "udp://65.109.200.75:5515"
        tag: "{{.Name}}"

  # React frontend (optional)
  ui:
    build: ./ui
    # image: ghcr.io/itsxcr9/ancientreport/ui:latest  # Commented out to build with PrometheusDiscovery
    container_name: AncientReport-ui
    ports:
      - "6080:3000"
    environment:
      TZ: Asia/Tehran
      REACT_APP_API_URL: http://localhost:8000
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    depends_on:
      - analysis
    networks:
      - AncientReport
    restart: unless-stopped
    logging:
      driver: syslog
      options:
        syslog-address: "udp://65.109.200.75:5515"
        tag: "{{.Name}}"

volumes:
  nats-data:
  clickhouse_data:

networks:
  AncientReport:
    driver: bridge
