# AncientReport Agent Configuration
# Copy this file to .env and configure for your environment

# ============================================
# REQUIRED: Central ClickHouse Server
# ============================================
# IP address or hostname of your central monitoring server
CLICKHOUSE_HOST=192.168.1.100

# ClickHouse port (default: 6123 if following central setup)
CLICKHOUSE_PORT=6123

# ClickHouse database credentials
CLICKHOUSE_DB=AncientReport
CLICKHOUSE_USER=AncientReport
CLICKHOUSE_PASSWORD=AncientReport

# ============================================
# Agent Configuration
# ============================================
# Hostname for this server (appears in UI and reports)
# If set to "auto-detect", will use the system hostname
# Examples: web-server-1, db-server-2, api-server-3
AGENT_HOSTNAME=auto-detect

# Timezone (should match your central server)
TZ=Asia/Tehran

# ============================================
# Example Configurations
# ============================================
# Web Server:
# AGENT_HOSTNAME=web-server-1
#
# Database Server:
# AGENT_HOSTNAME=db-server-main
#
# API Server:
# AGENT_HOSTNAME=api-server-prod
